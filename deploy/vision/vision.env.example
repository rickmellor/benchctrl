# Installs to /etc/benchctrl/vision.env (0644 — no secrets in here).
# Read by /usr/local/bin/benchctrl-vision-run (installed from deploy/vision/run-vision.sh).
# No quotes, no `export`: the run script sources this as sh, and systemd never reads it.

# The image built by deploy/vision/build.sh.
IMAGE=benchctrl-vision:1.8.0

# The benchctrl checkout whose src/ the container mounts read-only. A `git pull`
# here plus `systemctl restart benchctrl-vision` is the whole upgrade.
SRC_DIR=/home/rick/benchctrl/src

# Where the compiled .axm models live on the host (deploy/vision/fetch-model.sh).
MODEL_DIR=/home/rick/benchctrl/models
MODEL=yolov8n-coco.axm

# Loopback only. The sidecar has no authentication; the agent is the network face.
PORT=8095
# Optional read-only VIEW port on the LAN: serves /stream (MJPEG) and /frame.jpg
# only, for focusing and for watching the bench from a browser. Cannot trigger,
# configure or read structured state. 0 = off.
VIEW_PORT=8096

# Camera defaults. Tune exposure first; see docs/vision.md.
EXPOSURE_US=8000
GAIN_DB=0
FPS=60
TRIGGER_MODE=triggered        # triggered | free-run
JPEG_QUALITY=80
AIPU_CORES=4
# Set to 1 on a host with a camera but no Metis (or to bring the camera up first).
NO_AIPU=0
