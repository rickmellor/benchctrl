#!/bin/sh
# The kiosk X session: start the dashboard, then a fullscreen browser at it.
#
# Named as an xsession (see benchctrl-kiosk.desktop) and selected by lightdm's
# autologin, so the board boots straight to the panel with no keyboard.
#
# Recovery, because this session has no menu, no terminal, and no way to log
# out — the board has no keyboard attached:
#
#     ssh arduino@<board>
#     sudo rm /etc/lightdm/lightdm.conf.d/90-benchctrl-kiosk.conf
#     sudo systemctl restart lightdm      # back to the normal greeter
#
# That is why lightdm is configured with a drop-in rather than by editing
# lightdm.conf: recovery is deleting one file, not un-editing a 6 KB config.

set -u

log() { logger -t benchctrl-kiosk "$@"; }

# The FUI is the display. There is no longer a choice of two: the Streamlit panel
# this replaced has been removed from the tree. Running both meant a second
# process holding a second port and ~130 MB of RSS behind a panel nobody was
# looking at, and a switch between them was a way to be confused about which one
# you were reading. The stale-reclamation loop below still knows the old process
# names, because a board that has not been reimaged may still have one running.
DASHBOARD=${BENCHCTRL_DASHBOARD_CMD:-/usr/local/bin/benchctrl-fui}
PORT=${BENCHCTRL_FUI_PORT:-8600}
URL="http://127.0.0.1:$PORT"

log "starting kiosk session on ${DISPLAY:-<no DISPLAY>}"

# --- screen hygiene -------------------------------------------------------
# A status panel that blanks after 10 minutes is a panel that is off when you
# walk up to the bench, which is the moment it had one job.
xset s off || true
xset s noblank || true
xset -dpms || true
# Park the pointer out of the way. No mouse is attached today, and a cursor
# sitting in the middle of the readout is just noise.
command -v unclutter >/dev/null 2>&1 && unclutter -idle 1 &

# A plain background rather than whatever the desktop default is, so the moment
# between X starting and the browser drawing does not flash a stranger's
# wallpaper at the operator.
command -v xsetroot >/dev/null 2>&1 && xsetroot -solid '#11151a'

# Ask X for the panel's real geometry rather than hardcoding it, so a different
# monitor does not letterbox the display. Falls back to the board's own panel
# size if xrandr is absent or says something unparseable.
GEOM=""
if command -v xrandr >/dev/null 2>&1; then
    GEOM=$(xrandr 2>/dev/null | sed -n 's/^ *\([0-9]\{3,\}\)x\([0-9]\{3,\}\) .*\*.*/\1,\2/p' | head -1)
fi
[ -n "$GEOM" ] || GEOM=1440,900
log "panel geometry: $GEOM"

# --- clear out any previous display ---------------------------------------
# A dashboard left over from an earlier session — a Streamlit from before this
# board ran the FUI, or an FUI whose session died without its trap firing — keeps
# its port and its memory. On a 4-core board with ~2 GB of root filesystem that
# is not a harmless leak: Streamlit alone is ~130 MB of RSS and a live HTTP
# server, behind a panel nobody is reading.
#
# Matched via the bracket trick so the pattern cannot match this script's own
# invocation, and via pkill -f because these are `python3 -m ...` command lines
# with no distinguishing process name.
#
# Deliberately NOT a bare `streamlit run`: that would also kill
# applications/sensor_profiler, which is a legitimate unrelated Streamlit app.
# Reclaiming our own leftovers must not shoot a bystander.
for stale in 'benchctrl.dashboards.fu[i].server' 'benchctrl.dashboards.pane[l]'; do
    if pkill -f "$stale" 2>/dev/null; then
        log "stopped a leftover dashboard matching $stale"
    fi
done
# Give the port a moment to be released before binding it again, or the new
# server exits with EADDRINUSE and the panel shows a browser error instead.
sleep 1

# --- the dashboard --------------------------------------------------------
"$DASHBOARD" &
dashboard_pid=$!

# Kill the server when the session ends, or a logout leaves a stray process
# holding the port and the next login fails for a confusing reason.
trap 'kill "$dashboard_pid" 2>/dev/null || true' EXIT HUP INT TERM

# Wait for the port rather than sleeping a guessed number of seconds. The FUI is
# up almost immediately — it imports no third-party packages — but a browser that
# opens even slightly too early shows its own error page and stays there, and on
# a keyboard-less panel nobody can press reload.
#
# Pick a probe. /dev/tcp is deliberately not used: this is /bin/sh, where it is
# a bash-ism that would silently never match and turn the wait into a 90 s
# stall on every boot.
if command -v curl >/dev/null 2>&1; then
    probe() { curl -fsS --max-time 2 "$URL" >/dev/null 2>&1; }
elif command -v wget >/dev/null 2>&1; then
    probe() { wget -q -T 2 -O /dev/null "$URL" >/dev/null 2>&1; }
elif command -v nc >/dev/null 2>&1; then
    probe() { nc -z 127.0.0.1 "$PORT" >/dev/null 2>&1; }
else
    # Nothing to probe with. Wait a flat interval rather than pretending to
    # check, and say which it was — a browser opening too early is a visible
    # error page, and the operator should know why.
    log "no curl/wget/nc to probe with; waiting a fixed 20s instead"
    probe() { [ "$waited" -ge 20 ]; }
fi

waited=0
while [ "$waited" -lt 90 ]; do
    probe && break
    if ! kill -0 "$dashboard_pid" 2>/dev/null; then
        log "dashboard exited before serving; see: journalctl -t benchctrl-fui"
        break
    fi
    sleep 1
    waited=$((waited + 1))
done
log "dashboard reachable after ${waited}s (or gave up)"

# --- the browser ----------------------------------------------------------
for candidate in chromium chromium-browser google-chrome firefox; do
    command -v "$candidate" >/dev/null 2>&1 && BROWSER="$candidate" && break
done

if [ -z "${BROWSER:-}" ]; then
    log "no browser found; leaving X up so ssh recovery is still possible"
    # Do NOT exit: an exiting xsession makes lightdm loop, and with autologin
    # on that is an unattended restart loop nobody can interrupt from the board.
    exec sleep infinity
fi

case "$BROWSER" in
firefox)
    exec "$BROWSER" --kiosk "$URL"
    ;;
*)
    # --incognito so a crashed session does not come back with a "restore
    # pages?" bubble covering the readout, which is exactly the kind of thing
    # nobody can dismiss without a mouse.
    # --kiosk alone is not reliably fullscreen: it asks the window manager for
    # it, and if xfwm is already managing a window (a leftover display, a second
    # launch) the request can be ignored and the panel gets a ~1050x880 window
    # with the layout squeezed into 73% of the screen. Observed on this board.
    # --start-fullscreen and an explicit geometry make it not a request.
    exec "$BROWSER" \
        --kiosk \
        --start-fullscreen \
        --window-position=0,0 \
        --window-size="$GEOM" \
        --incognito \
        --noerrdialogs \
        --disable-infobars \
        --disable-session-crashed-bubble \
        --disable-features=TranslateUI \
        --no-first-run \
        --check-for-update-interval=31536000 \
        --password-store=basic \
        --app="$URL"
    ;;
esac
