# Installs to /etc/benchctrl/agent.env (0644 — no secrets in here).
#
# PYTHONPATH is how a pip-less board finds the package. On an Uno Q deployed
# per docs/remote.md, benchctrl and pyserial sit side by side in one directory:
#
#   /home/arduino/benchctrl-1.2.0/src/benchctrl/
#   /home/arduino/benchctrl-1.2.0/src/serial/
#
PYTHONPATH=/home/arduino/benchctrl-1.2.0/src

# Unbuffered, so journalctl shows log lines as they happen instead of when the
# stdio buffer flushes. Without this a crash can lose the lines explaining it.
PYTHONUNBUFFERED=1

# The token belongs in agent.json (0640), not here: EnvironmentFile values are
# readable via `systemctl show` by any local user. Set BENCHCTRL_TOKEN here
# only if you have no config file at all.
#BENCHCTRL_TOKEN=
