__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
.venv/
venv/
.tox/

# captures / measurement artefacts (kept out of source control)
*.opensmu
*.raw
*.csv
*.json
!docs/**/*.json
!tests/fixtures/*.json
!validation/scenarios/*.json
!validation/scenarios/*.csv

# sensor_profiler captured data — kept out of source control
# (the application code is committed; users create their own runs/)
applications/*/runs/
applications/*/__pycache__/

# Vendor manuals and datasheets used while writing drivers. Redistributing
# them here would be a copyright problem, and they're large binaries that
# bloat clones. Drivers cite the specific facts they depend on in comments
# (command, range, tolerance) so the code stands alone without the PDF.
references/
*.pdf
*.pdf:Zone.Identifier
*.pdf:MSOAVINFO
